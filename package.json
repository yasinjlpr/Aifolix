{
  "name": "path-forge",
  "version": "1.4.0",
  "description": "Convert a folder tree text into a Windows BAT folder/file creation script.",
  "main": "main.js",
  "author": "Yasin Jalilpour",
  "copyright": "Copyright © 2026 Yasin Jalilpour. All rights reserved.",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.yasinjalilpour.pathforge",
    "productName": "PathForge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
